{
	"buildCommand": "npm run build",
	"outputDirectory": "dist",
	"rewrites": [
		{ "source": "/app", "destination": "/app/index.html" },
		{ "source": "/admin", "destination": "/admin.html" },
		{ "source": "/come-funziona", "destination": "/come-funziona.html" },
		{ "source": "/faq", "destination": "/faq.html" },
		{ "source": "/blog", "destination": "/blog/index.html" },
		{ "source": "/blog/cose-una-tolerance-break", "destination": "/blog/cose-una-tolerance-break.html" },
		{ "source": "/blog/come-ridurre-il-consumo-di-cannabis", "destination": "/blog/come-ridurre-il-consumo-di-cannabis.html" },
		{ "source": "/blog/perche-tenere-un-diario-di-consumo", "destination": "/blog/perche-tenere-un-diario-di-consumo.html" }
	],
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
			]
		},
		{
			"source": "/(.*)\\.(js|css)",
			"headers": [
				{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
			]
		},
		{
			"source": "/marketing.css",
			"headers": [
				{ "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }
			]
		},
		{
			"source": "/locales/(.*)\\.json",
			"headers": [
				{ "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }
			]
		},
		{
			"source": "/manifest.json",
			"headers": [
				{ "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }
			]
		},
		{
			"source": "/sw.js",
			"headers": [
				{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
			]
		},
		{
			"source": "/(.*)\\.(png|jpg|jpeg|webp|svg|ico)",
			"headers": [
				{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
			]
		},
		{
			"source": "/(.*)\\.(woff|woff2|ttf|otf)",
			"headers": [
				{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
			]
		}
	]
}
